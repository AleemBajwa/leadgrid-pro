{
  "manifest_version": 3,
  "name": "LeadGrid: Google Maps B2B Lead Scraper & Email Enricher",
  "version": "1.0.0",
  "description": "Extract unlimited B2B leads from Google Maps with automatic grid-panning, phone numbers, and deep website email enrichment.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://www.google.com/maps",
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LeadGrid Scraper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/maps/*"],
      "js": ["content/maps_scraper.js"],
      "run_at": "document_idle"
    }
  ]
}
